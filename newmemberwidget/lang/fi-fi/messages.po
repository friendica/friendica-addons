#: newmemberwidget.php:29
msgid "New Member"
msgstr "Uusi jäsen"

#: newmemberwidget.php:30
msgid "Tips for New Members"
msgstr "Vinkkejä uusille käyttäjille"

#: newmemberwidget.php:33
msgid "Global Support Group"
msgstr "Yleinen tukiryhmä"

#: newmemberwidget.php:37
msgid "Local Support Group"
msgstr "Paikallinen tukiryhmä"

#: newmemberwidget.php:62
msgid "Save Settings"
msgstr "Tallenna asetukset"

#: newmemberwidget.php:63
msgid "Message"
msgstr "Viesti"

#: newmemberwidget.php:63
msgid "Your message for new members. You can use bbcode here."
msgstr "Viestisi uusille jäsenille. Tässä voi käyttää bbcodea."

#: newmemberwidget.php:64
msgid "Add a link to global support group"
msgstr "Lisää linkki yleiseen tukiryhmään"

#: newmemberwidget.php:64
msgid "Should a link to the global support group be displayed?"
msgstr "Tulisiko näyttää linkki yleiseen tukiryhmään?"

#: newmemberwidget.php:65
msgid "Add a link to the local support group"
msgstr "Lisää linkki paikalliseen tukiryhmään"

#: newmemberwidget.php:65
msgid ""
"If you have a local support group and want to have a link displayed in the "
"widget, check this box."
msgstr "Jos on olemassa paikallinen tukiryhmä ja haluat sen linkin näkyvän sovelmassa, valitse tämä."

#: newmemberwidget.php:66
msgid "Name of the local support group"
msgstr "Paikallisen tukifoorumin nimi"

#: newmemberwidget.php:66
msgid ""
"If you checked the above, specify the <em>nickname</em> of the local support"
" group here (i.e. helpers)"
msgstr "Jos valitsit yllä olevan asetuksen, määritä paikallisen tukiryhmän <em>lempinimi</em> tähän (esim. ohjeita)"

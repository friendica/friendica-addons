#: blackout.php:97
msgid ""
"The end-date is prior to the start-date of the blackout, you should fix "
"this."
msgstr "Slutdatoen ligger før startdatoen for blackoutet, dette bør du ordne."

#: blackout.php:99
#, php-format
msgid ""
"Please double check the current settings for the blackout. It will begin on "
"<strong>%s</strong> and end on <strong>%s</strong>."
msgstr "Vær venlig at kontrollere dine nuværende indstillinger for blackoutet. Det starter <strong>%s</strong> og slutter <strong>%s</strong>"

#: blackout.php:102
msgid "Save Settings"
msgstr "Gem indstillinger"

#: blackout.php:103
msgid "Redirect URL"
msgstr "Viderestil URL"

#: blackout.php:103
msgid "All your visitors from the web will be redirected to this URL."
msgstr "Alle dine besøgende fra interenettet vil blive viderestillet til denne URL."

#: blackout.php:104
msgid "Begin of the Blackout"
msgstr "Blackout starter"

#: blackout.php:104
msgid ""
"Format is <tt>YYYY-MM-DD hh:mm</tt>; <em>YYYY</em> year, <em>MM</em> month, "
"<em>DD</em> day, <em>hh</em> hour and <em>mm</em> minute."
msgstr "Formatet er <strong>ÅÅÅÅ-MM-DD tt:mm</strong>; <strong>ÅÅÅÅ</strong>år, <strong>MM</strong> måned, <strong>DD</strong> dag, <strong>hh</strong> time og <strong>mm</strong> minut."

#: blackout.php:105
msgid "End of the Blackout"
msgstr "Blackout slutter"

#: blackout.php:107
msgid ""
"<strong>Note</strong>: The redirect will be active from the moment you press"
" the submit button. Users currently logged in will <strong>not</strong> be "
"thrown out but can't login again after logging out while the blackout is "
"still in place."
msgstr "<strong>Note</strong>: Viderestillingenvil være aktiveret fra det øjeblik, du trykker på send-knappen. Indloggede brugere vil <strong>ikke</strong> blive smidt af, men kan ikke logge på igen efter at have logget ud, mens blackoutet er aktivt."

#: curweather.php:47
msgid "Error fetching weather data. Error was: "
msgstr "Fejl i indlæsning af vejrdata. Fejlen var: "

#: curweather.php:130
msgid "Current Weather"
msgstr "Nuværende vejr"

#: curweather.php:137
msgid "Relative Humidity"
msgstr "Relativ fugtighed"

#: curweather.php:138
msgid "Pressure"
msgstr "Tryk"

#: curweather.php:139
msgid "Wind"
msgstr "Vind"

#: curweather.php:140
msgid "Last Updated"
msgstr "Senest opdateret"

#: curweather.php:141
msgid "Data by"
msgstr "Data af"

#: curweather.php:142
msgid "Show on map"
msgstr "Vis på kort"

#: curweather.php:147
msgid "There was a problem accessing the weather data. But have a look"
msgstr "Der var et problem med at tilgå vejrdata. Men tag et kig."

#: curweather.php:149
msgid "at OpenWeatherMap"
msgstr "Hos OpenWeatherMap"

#: curweather.php:178
msgid "No APPID found, please contact your admin to obtain one."
msgstr "Intet APPID fundet, kontakt venligst din administrator for at få fat i ét."

#: curweather.php:188
msgid "Enter either the name of your location or the zip code."
msgstr "Indtast enten navnet på din placering eller postnummeret."

#: curweather.php:189
msgid "Your Location"
msgstr "Din placering"

#: curweather.php:189
msgid ""
"Identifier of your location (name or zip code), e.g. <em>Berlin,DE</em> or "
"<em>14476,DE</em>."
msgstr "Identifikationer på din placering (navn eller postnummer), såsom. <em>Copenhagen,DK</em> eller <em>2025,DK</em>."

#: curweather.php:190
msgid "Units"
msgstr "Enheder"

#: curweather.php:190
msgid "select if the temperature should be displayed in &deg;C or &deg;F"
msgstr "Vælg om temperaturen skal vises i &deg;C eller &deg;F"

#: curweather.php:191
msgid "Show weather data"
msgstr "Vis vejrdata"

#: curweather.php:196
msgid "Current Weather Settings"
msgstr "Nuværende vejrindstillinger"

#: curweather.php:227
msgid "Save Settings"
msgstr "Gem indstillinger"

#: curweather.php:230
msgid "Caching Interval"
msgstr "Caching-interval"

#: curweather.php:232
msgid ""
"For how long should the weather data be cached? Choose according your "
"OpenWeatherMap account type."
msgstr "Hvor længe skal vejrdata være cachet? Vælg baseret på din OpenWeatherMap-kontotype."

#: curweather.php:233
msgid "no cache"
msgstr "ingen cache"

#: curweather.php:234 curweather.php:235 curweather.php:236 curweather.php:237
msgid "minutes"
msgstr "minutter"

#: curweather.php:240
msgid "Your APPID"
msgstr "Dit APPID"

#: curweather.php:240
msgid "Your API key provided by OpenWeatherMap"
msgstr "Din API-nøgle tildelt fra OpenWeatherMap"

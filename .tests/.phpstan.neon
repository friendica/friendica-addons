parameters:
    level: 3

    phpVersion: 80200 # PHP 8.2

    paths:
        - ../

    scanDirectories:
        - ../../mod
        - ../../src
        - ../../static
        - ../../vendor
        - ../../view

    excludePaths:
        analyse:
            - ../*/lang/*
            - ../*/vendor/*
            - ../convert/UnitConvertor.php
            - ../pumpio/oauth/*
            - ../mailstream/phpmailer/*
        analyseAndScan:
            - ../../vendor/rector/
            - ../../vendor/phpstan/

    dynamicConstantNames:
        - DB_UPDATE_VERSION

    ignoreErrors: []
